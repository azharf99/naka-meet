# Env file for the L3 Playwright E2E stack ONLY (docker-compose.e2e.yml,
# e2e/ tests, CI's test-e2e job) — never used for a real deployment. Every
# value below is a throwaway, non-secret default; committing it is safe.
POSTGRES_DB=nakameet
POSTGRES_USER=nakameet
POSTGRES_PASSWORD=e2e-test-password
PORT=8080
REDIS_URL=redis:6379
DB_DSN=postgres://nakameet:e2e-test-password@postgres:5432/nakameet?sslmode=disable
WEBRTC_UDP_PORT_MIN=50000
WEBRTC_UDP_PORT_MAX=50050
JWT_SECRET=e2e-test-jwt-secret-not-for-real-use
FRONTEND_URL=http://frontend:3000
# Both localhost and 127.0.0.1 listed deliberately — the origin.spec.ts test
# joins from http://127.0.0.1:3000 specifically to prove a non-default
# origin, once actually configured in ALLOWED_ORIGINS, is accepted end to
# end (the regression test for Issue 1 from the postmortem, scripted rather
# than manual).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
DISPLAY=:99
TURN_SECRET=
TURN_HOST=
TURN_PORT=3478
TURN_REALM=naka-meet.local
TURN_EXTERNAL_IP=
