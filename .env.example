POSTGRES_DB=nakameet
POSTGRES_USER=nakameet
POSTGRES_PASSWORD=change-me
PORT=8080
REDIS_URL=redis:6379
DB_DSN=postgres://nakameet:change-me@postgres:5432/nakameet?sslmode=disable
WEBRTC_UDP_PORT_MIN=50000
WEBRTC_UDP_PORT_MAX=50050
# Required, no fallback — a well-known default checked into source would
# let anyone forge a host JWT for any room.
JWT_SECRET=change-me-to-a-long-random-string
# Container-internal address the egress worker's headless Chromium uses to
# reach the frontend. Its origin is automatically added to the
# ALLOWED_ORIGINS allowlist below at startup (see main.go's
# resolveAllowedOrigins) — you do not need to duplicate it there yourself.
FRONTEND_URL=http://frontend:3000
# Browser-facing origin(s) allowed for CORS/WS-upgrade (comma-separated).
# Must include every origin real participants will actually reach this
# deployment from — localhost only covers one browser on one machine.
# Testing from a second device/browser on the same LAN needs that device's
# reachable origin added here too (e.g. http://<this-machine's-LAN-IP>:3000
# — check with `ipconfig`/`ip addr`), or its WS connection is silently
# rejected and it never appears in anyone's grid.
ALLOWED_ORIGINS=http://localhost:3000
# Set to true once served over HTTPS so the jwt_token cookie gets Secure.
COOKIE_SECURE=false
DISPLAY=:99

# --- TURN (optional) ---
# STUN alone (the app's built-in default) silently strands any participant
# whose network needs a relay — symmetric NAT, most mobile carriers,
# restrictive corporate firewalls. Invisible when everyone's on the same
# LAN, which is exactly why it's easy to ship without noticing. Leaving
# TURN_SECRET empty (the default) keeps the app working exactly as before;
# set these three, plus TURN_EXTERNAL_IP for a real deployment, and start
# the optional coturn service with:
#   docker-compose --profile turn up --build
#
# Shared secret between this backend and the coturn service — coturn is
# started with --static-auth-secret=$TURN_SECRET (see docker-compose.yml);
# the backend uses the same value to derive time-limited credentials
# (pkg/turn) it hands each participant via GET /api/v1/ice-servers.
TURN_SECRET=
# The hostname/IP participants' browsers should reach the TURN server at —
# usually this deployment's public IP or domain, NOT a Docker-internal
# hostname (unlike FRONTEND_URL, browsers do see this one directly).
TURN_HOST=
TURN_PORT=3478
# coturn's own advertised realm; cosmetic, shown to some TURN clients.
TURN_REALM=naka-meet.local
# Required for a real deployment: without it coturn may advertise its
# Docker-internal IP as the relay address, which is unreachable from
# outside the container. Set to this machine's actual public IP.
TURN_EXTERNAL_IP=
